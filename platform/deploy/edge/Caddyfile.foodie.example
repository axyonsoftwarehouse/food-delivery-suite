entregador.DOMINIO_DE_PRODUCAO,
admin.DOMINIO_DE_PRODUCAO {
    import foodie_seguranca
    encode zstd gzip
    import foodie_site foodie-production
}

api.DOMINIO_DE_PRODUCAO {
    import foodie_seguranca
    encode zstd gzip
    import foodie_api foodie-production
}
