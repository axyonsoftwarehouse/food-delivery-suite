FOODIE_DOMAIN=staging.example.com
DB_PASSWORD=replace-with-a-long-random-password
DB_ROOT_PASSWORD=replace-with-a-different-long-random-password
# Usada apenas pelo perfil "tools" (seed demonstrativo):
DEMO_PASSWORD=replace-with-a-demo-password

# Sentry (opcional; sem DSN o SDK fica desligado)
# Alternativa: crie deploy/sentry.env (modo 600) com estas chaves; o deploy.sh carrega.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ENVIRONMENT=staging
SENTRY_TRACES_SAMPLE_RATE=0
# Painel do admin: token pessoal somente leitura (org:read, project:read, event:read)
SENTRY_API_URL=https://sentry.io/api/0
SENTRY_ORG_SLUG=axyon-software-house
SENTRY_PROJECTS=foodie-api,foodie-web
SENTRY_API_TOKEN=
SENTRY_CACHE_SECONDS=60
