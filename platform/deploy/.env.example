FOODIE_DOMAIN=staging.example.com
DB_PASSWORD=replace-with-a-long-random-password
DB_ROOT_PASSWORD=replace-with-a-different-long-random-password
# Usada apenas pelo perfil "tools" (seed demonstrativo):
DEMO_PASSWORD=replace-with-a-demo-password

# Pagamentos (pedido): Mercado Pago por loja via OAuth.
MERCADOPAGO_BASE_URL=https://api.mercadopago.com
MERCADOPAGO_AUTH_BASE_URL=https://auth.mercadopago.com.br
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_WEBHOOK_TOLERANCE_SECONDS=300
MERCADOPAGO_CARD_3DS=on_fraud_risk
MERCADOPAGO_CLIENT_ID=
MERCADOPAGO_CLIENT_SECRET=
MERCADOPAGO_OAUTH_REDIRECT_URI=
PAYMENTS_TOKEN_KEY=
PAYMENTS_ALLOW_DIRECT_ONLINE_CHARGES=false
PAYMENTS_REQUIRE_TEST_ACCOUNTS=false
PAYMENTS_ACCOUNT_RETURN_URL=
# Origens de navegador aceitas em escritas com cookie (CSRF). O Compose monta o padrão
# a partir de FOODIE_DOMAIN (domínio base, quatro papéis e API); em produção liste o domínio real.
APP_ALLOWED_ORIGINS=

# Assinatura da loja (receita da Foodie). Sem a flag e o token, o job não cobra.
SUBSCRIPTIONS_ALLOW_REAL_CHARGES=false
SUBSCRIPTIONS_ACCOUNT_ACCESS_TOKEN=
SUBSCRIPTIONS_ACCOUNT_PUBLIC_KEY=
SUBSCRIPTIONS_TRIAL_DAYS=15
SUBSCRIPTIONS_REMIND_BEFORE_DAYS=3
SUBSCRIPTIONS_GRACE_DAYS=5
SUBSCRIPTIONS_RETRY_EVERY_DAYS=2

# Autenticação, sessão e login social.
REQUIRE_EMAIL_VERIFICATION=true
SESSION_DAYS=3
SESSION_IDLE_MINUTES=1440
GOOGLE_CLIENT_ID=
GOOGLE_BASE_URL=https://oauth2.googleapis.com
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_BASE_URL=https://graph.facebook.com
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5

# SMS do OTP: local (log), twilio ou generic (webhook).
SMS_PROVIDER=local
SMS_LOG_BODY=false
SMS_FROM=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_BASE_URL=https://api.twilio.com
SMS_GENERIC_URL=
SMS_GENERIC_TOKEN=

# E-mail de verificação/recuperação: log (imprime no log) ou smtp (produção).
MAIL_PROVIDER=log
MAIL_LOG_BODY=false
MAIL_FROM=
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true

# Provedores opcionais, mapas, limites de upload e push dos apps.
MAPBOX_TOKEN=
MAPBOX_BASE_URL=https://api.mapbox.com
OPENAI_BASE_URL=https://api.openai.com
OPENAI_MODEL=gpt-4o-mini
STORAGE_MAX_IMAGE_BYTES=5242880
STORAGE_MAX_DOCUMENT_BYTES=10485760
FCM_SERVICE_ACCOUNT_JSON=
FCM_PROJECT_ID=
WEBPUSH_PUBLIC_KEY=
WEBPUSH_PRIVATE_KEY=
WEBPUSH_SUBJECT=mailto:contato@foodie.local

# Sentry (opcional; sem DSN o SDK fica desligado)
# Alternativa: crie deploy/sentry.env (modo 600) com estas chaves; o deploy.sh carrega.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ENVIRONMENT=staging
SENTRY_TRACES_SAMPLE_RATE=0
# Painel do admin: token pessoal somente leitura (org:read, project:read, event:read)
SENTRY_API_URL=https://sentry.io/api/0
SENTRY_ORG_SLUG=axyon-software-house
SENTRY_PROJECTS=foodie-api,foodie-web
SENTRY_API_TOKEN=
SENTRY_CACHE_SECONDS=60

# Buscadores: só a produção indexa o site (robots.txt e sitemap). Deixe false no staging.
SITE_INDEXABLE=false
