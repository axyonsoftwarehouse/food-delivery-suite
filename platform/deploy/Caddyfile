(security_headers) {
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "no-referrer"
        Permissions-Policy "camera=(), microphone=(self), geolocation=(self)"
        Content-Security-Policy "frame-ancestors 'none'; base-uri 'self'; object-src 'none'"
        -Server
    }
}

# Site: /backend/* vai direto para a API, sem passar pelo Next (teste de carga de 11/11/2026: o Next
# repassando as chamadas era o gargalo do nível 2). O `rewrites` do next.config continua valendo
# para quem roda o site sem este Caddy (desenvolvimento local).
(foodie_site) {
    route {
        # Actuator e documentação da API não são públicos, como no api.; o monitoramento usa a rede interna.
        @interno_backend path /backend/actuator* /backend/v3/api-docs* /backend/swagger-ui*
        respond @interno_backend 404
        handle_path /backend/* {
            reverse_proxy api:4001 {
                # Descarta um X-Forwarded-For enviado pelo cliente; os limites por IP leem este cabeçalho.
                header_up X-Forwarded-For {http.request.remote.host}
            }
        }
        reverse_proxy web:3001 {
            header_up X-Forwarded-For {http.request.remote.host}
        }
    }
}

{$FOODIE_DOMAIN} {
    import security_headers
    encode zstd gzip
    import foodie_site
}

api.{$FOODIE_DOMAIN} {
    import security_headers
    encode zstd gzip
    # Actuator e documentação da API não são públicos; o monitoramento acessa a rede interna.
    @internal path /actuator* /v3/api-docs* /swagger-ui*
    respond @internal 404
    reverse_proxy api:4001 {
        header_up X-Forwarded-For {http.request.remote.host}
    }
}

cliente.{$FOODIE_DOMAIN}, restaurante.{$FOODIE_DOMAIN}, entregador.{$FOODIE_DOMAIN}, admin.{$FOODIE_DOMAIN} {
    import security_headers
    encode zstd gzip
    import foodie_site
}
