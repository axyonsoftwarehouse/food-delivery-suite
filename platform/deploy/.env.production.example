# Variáveis que a PRODUÇÃO tem de definir em /home/deploy/foodie-production/deploy/.env (modo 600).
# Este arquivo não tem valores de verdade: segredos e domínio ficam só na VPS.
# Antes de publicar, o deploy roda `conferir-env.sh production` e para se algo aqui estiver errado.
# Nenhuma senha, chave ou token pode ser igual ao do staging (decisão de 14/10/2026).

# --- Ambiente -----------------------------------------------------------------
COMPOSE_PROJECT_NAME=foodie-production
# Domínio de produção, sem https:// (ex.: exemplo.com.br). Os subdomínios api., cliente.,
# restaurante., entregador. e admin. saem dele.
FOODIE_DOMAIN=
SENTRY_ENVIRONMENT=production
SITE_INDEXABLE=true

# --- Limites (a produção fica com a maior parte da VPS) ------------------------
API_MEMORY=1280m
DB_MEMORY=512m
WEB_MEMORY=384m
# 0 = sem limite de CPU; o limite de 1 núcleo é só do staging.
FOODIE_CPUS=0
DB_BUFFER_POOL=256M

# --- Banco (gerar na VPS: openssl rand -base64 32) -----------------------------
DB_PASSWORD=
DB_ROOT_PASSWORD=
# Tem de ficar vazia: a produção não tem contas de demonstração.
DEMO_PASSWORD=

# --- Pagamentos (aplicação de PRODUÇÃO do Mercado Pago) ------------------------
PAYMENTS_REQUIRE_TEST_ACCOUNTS=false
# Chave que cifra os tokens das lojas no banco (gerar na VPS: openssl rand -base64 32).
PAYMENTS_TOKEN_KEY=
MERCADOPAGO_CLIENT_ID=
MERCADOPAGO_CLIENT_SECRET=
MERCADOPAGO_WEBHOOK_SECRET=

# --- Assinatura (conta que recebe a mensalidade das lojas) ---------------------
SUBSCRIPTIONS_ACCOUNT_ACCESS_TOKEN=
SUBSCRIPTIONS_ACCOUNT_PUBLIC_KEY=
# Só vira true quando a cobrança real for liberada; até lá o deploy avisa, mas publica.
SUBSCRIPTIONS_ALLOW_REAL_CHARGES=false

# --- E-mail real (o modo `log` é recusado na produção) -------------------------
MAIL_PROVIDER=smtp
MAIL_FROM=
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=

# --- Notificações no navegador (par de chaves novo, não o do staging) ----------
WEBPUSH_PUBLIC_KEY=
WEBPUSH_PRIVATE_KEY=
# Obrigatória: vazia, vale o padrão do staging (mailto:contato@foodie.local). Ex.: mailto:contato@<domínio>
WEBPUSH_SUBJECT=

# --- Sentry --------------------------------------------------------------------
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# --- Opcionais: sem eles o deploy só avisa --------------------------------------
# SMS do login por código. `local` não envia nada.
SMS_PROVIDER=local
# Login social.
GOOGLE_CLIENT_ID=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
MAPBOX_TOKEN=
