API_PORT=4001
API_HOST=127.0.0.1
COOKIE_SECURE=false
PUBLIC_BASE_URL=http://127.0.0.1:3001
# Mercado Pago (pagamento online: Pix e cartão). Deixe em branco para desativar.
# Use credencial de TESTE (prefixo TEST-) fora de produção.
MERCADOPAGO_ACCESS_TOKEN=
# Segredo do webhook que o painel do Mercado Pago gera (evento "Order"). Sem ele a assinatura
# NÃO é conferida e qualquer origem é aceita.
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_BASE_URL=https://api.mercadopago.com
# Public key da aplicação (não é segredo): o navegador usa para tokenizar o cartão.
MERCADOPAGO_PUBLIC_KEY=
# Chave que cifra os tokens do Mercado Pago das lojas (openssl rand -base64 32)
PAYMENTS_TOKEN_KEY=
# Caminho de teste/homologação: permite CRIAR cobrança online nova. Desligado por padrão —
# em produção o recebimento é direto pelo restaurante (decisão comercial pendente).
PAYMENTS_ALLOW_DIRECT_ONLINE_CHARGES=false
# Mapbox (geocodificação de endereço e cálculo de distância/rota). Deixe em branco para usar Haversine (linha reta).
MAPBOX_TOKEN=
MAPBOX_BASE_URL=https://api.mapbox.com
# Web Push (notificações no navegador). Gere um par de chaves VAPID.
WEBPUSH_PUBLIC_KEY=
WEBPUSH_PRIVATE_KEY=
WEBPUSH_SUBJECT=mailto:contato@foodie.local
# Firebase Cloud Messaging (push nos apps). Informe o JSON da conta de serviço em uma linha.
FCM_SERVICE_ACCOUNT_JSON=
FCM_PROJECT_ID=
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=foodie
DB_PASSWORD=change-me
DB_NAME=foodie_platform
