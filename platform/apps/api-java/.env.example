API_PORT=4001
API_HOST=127.0.0.1
COOKIE_SECURE=false
PUBLIC_BASE_URL=http://127.0.0.1:3001
# Mercado Pago (pagamento online: Pix e cartão). Deixe em branco para desativar.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_BASE_URL=https://api.mercadopago.com
MERCADOPAGO_NOTIFICATION_URL=
# Mapbox (geocodificação de endereço e cálculo de distância/rota). Deixe em branco para usar Haversine (linha reta).
MAPBOX_TOKEN=
MAPBOX_BASE_URL=https://api.mapbox.com
# Web Push (notificações no navegador). Gere um par de chaves VAPID.
WEBPUSH_PUBLIC_KEY=
WEBPUSH_PRIVATE_KEY=
WEBPUSH_SUBJECT=mailto:contato@foodie.local
# Retorno do pagamento online no app (deep link ou página HTTPS). Opcional; Pix não usa.
MOBILE_PAYMENT_RETURN_URL=
# Firebase Cloud Messaging (push nos apps). Informe o JSON da conta de serviço em uma linha.
FCM_SERVICE_ACCOUNT_JSON=
FCM_PROJECT_ID=
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=foodie
DB_PASSWORD=change-me
DB_NAME=foodie_platform
