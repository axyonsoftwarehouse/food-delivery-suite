DB_PASSWORD=choose-a-long-random-password
DB_ROOT_PASSWORD=choose-another-long-random-password
COOKIE_SECURE=false
# Mapbox (geocodificação e rota). Pode ficar vazio (usa Haversine).
MAPBOX_TOKEN=
# Mercado Pago (pagamento online: Pix e cartão). Deixe em branco para desativar.
# Use credencial de TESTE (prefixo TEST-) fora de produção.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_BASE_URL=https://api.mercadopago.com
# Segredo que o painel do Mercado Pago gera para o webhook do app (Webhooks > Configurar
# notificações > evento "Order"). Sem ele a assinatura NÃO é conferida e qualquer origem é aceita.
# A URL de callback não tem variável: ela é registrada no painel do app, não no .env (a API de
# Orders recusa `notification_url` no corpo).
MERCADOPAGO_WEBHOOK_SECRET=
# Public key da aplicação (começa com TEST- em teste). Não é segredo: vai para o navegador e
# tokeniza o cartão no checkout transparente.
MERCADOPAGO_PUBLIC_KEY=
# Chave que cifra os tokens do Mercado Pago das lojas (openssl rand -base64 32)
PAYMENTS_TOKEN_KEY=
# Caminho de teste/homologação: permite CRIAR cobrança online nova. Desligado por padrão —
# em produção o recebimento é direto pelo restaurante (decisão comercial pendente).
PAYMENTS_ALLOW_DIRECT_ONLINE_CHARGES=false
# Firebase Cloud Messaging (push nos apps). JSON da conta de serviço em uma linha. Opcional.
FCM_SERVICE_ACCOUNT_JSON=
FCM_PROJECT_ID=
