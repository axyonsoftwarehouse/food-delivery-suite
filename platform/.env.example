DB_PASSWORD=choose-a-long-random-password
DB_ROOT_PASSWORD=choose-another-long-random-password
COOKIE_SECURE=false
# Mapbox (geocodificação e rota). Pode ficar vazio (usa Haversine).
MAPBOX_TOKEN=
# Mercado Pago (pagamento online: Pix e cartão). Deixe em branco para desativar.
MERCADOPAGO_BASE_URL=https://api.mercadopago.com
# Segredo que o painel do Mercado Pago gera para o webhook do app (Webhooks > Configurar
# notificações > evento "Order"). Sem ele toda notificação é recusada (401). Aceita vários,
# separados por vírgula (app principal e app do vendedor de teste).
# A URL de callback não tem variável: ela é registrada no painel do app, não no .env (a API de
# Orders recusa `notification_url` no corpo).
MERCADOPAGO_WEBHOOK_SECRET=
# 3DS do cartão: on_fraud_risk (padrão) ou never (chave de emergência; o chargeback de fraude volta a
# ser da loja). Mudar exige só reiniciar a API.
MERCADOPAGO_CARD_3DS=on_fraud_risk
# Chave que cifra os tokens do Mercado Pago das lojas (openssl rand -base64 32)
PAYMENTS_TOKEN_KEY=
# Caminho de teste/homologação: permite CRIAR cobrança online nova. Desligado por padrão —
# em produção o recebimento é direto pelo restaurante (decisão comercial pendente).
PAYMENTS_ALLOW_DIRECT_ONLINE_CHARGES=false
# Ambiente de testes: true recusa conectar conta Mercado Pago que não seja usuário de teste. O padrão (true) é o do
# staging: a produção TEM de definir PAYMENTS_REQUIRE_TEST_ACCOUNTS=false.
PAYMENTS_REQUIRE_TEST_ACCOUNTS=true
# Vinculação de contas (OAuth) — aplicação do Foodie no Mercado Pago
MERCADOPAGO_CLIENT_ID=
MERCADOPAGO_CLIENT_SECRET=
MERCADOPAGO_OAUTH_REDIRECT_URI=
# Volta ao painel depois da vinculação. Vazio = padrão do host de staging; a produção define a própria URL
# (https://<dominio>/painel/configuracoes).
PAYMENTS_ACCOUNT_RETURN_URL=
# Assinatura da loja (receita da Foodie). Sem a flag e o token, o job não cobra de verdade.
# A conta de recebimento da assinatura ainda está em discussão; no staging usa a conta de teste.
SUBSCRIPTIONS_ALLOW_REAL_CHARGES=false
SUBSCRIPTIONS_ACCOUNT_ACCESS_TOKEN=
SUBSCRIPTIONS_ACCOUNT_PUBLIC_KEY=
SUBSCRIPTIONS_TRIAL_DAYS=15
SUBSCRIPTIONS_REMIND_BEFORE_DAYS=3
SUBSCRIPTIONS_GRACE_DAYS=5
SUBSCRIPTIONS_RETRY_EVERY_DAYS=2

# Autenticação: verificação de e-mail, duração da sessão e login social.
REQUIRE_EMAIL_VERIFICATION=true
SESSION_DAYS=3
SESSION_IDLE_MINUTES=1440
GOOGLE_CLIENT_ID=
GOOGLE_BASE_URL=https://oauth2.googleapis.com
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_BASE_URL=https://graph.facebook.com
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5

# SMS do OTP: local (log), twilio ou generic (webhook).
SMS_PROVIDER=local
SMS_LOG_BODY=false
SMS_FROM=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_BASE_URL=https://api.twilio.com
SMS_GENERIC_URL=
SMS_GENERIC_TOKEN=

# E-mail de verificação/recuperação: log (imprime no log) ou smtp (produção).
MAIL_PROVIDER=log
MAIL_LOG_BODY=false
MAIL_FROM=
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true

# Provedores opcionais e limites de upload.
OPENAI_BASE_URL=https://api.openai.com
OPENAI_MODEL=gpt-4o-mini
MAPBOX_BASE_URL=https://api.mapbox.com
MERCADOPAGO_AUTH_BASE_URL=https://auth.mercadopago.com.br
MERCADOPAGO_WEBHOOK_TOLERANCE_SECONDS=300
STORAGE_MAX_IMAGE_BYTES=5242880
STORAGE_MAX_DOCUMENT_BYTES=10485760

# Firebase Cloud Messaging (push nos apps). JSON da conta de serviço em uma linha. Opcional.
FCM_SERVICE_ACCOUNT_JSON=
FCM_PROJECT_ID=

# Sentry (opcional; sem DSN o SDK fica desligado)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0
# Painel do admin: token pessoal somente leitura (org:read, project:read, event:read)
SENTRY_API_URL=https://sentry.io/api/0
SENTRY_ORG_SLUG=axyon-software-house
SENTRY_PROJECTS=foodie-api,foodie-web
SENTRY_API_TOKEN=
SENTRY_CACHE_SECONDS=60
